{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Backend",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/backend/build/backend",
            "args": ["--serial", "/dev/ttyUSB0", "--baud", "115200", "--js", "/dev/input/js0", "--port", "8080"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/backend/build",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Build Backend",
            "type": "cppdbg",
            "request": "launch",
            "program": "cmake",
            "args": [" --build ${workspaceFolder}/backend/build, --target all"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/backend/build",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }

    ]
}